POSTGRES_DB=gridmind
POSTGRES_USER=gridmind
POSTGRES_PASSWORD=gridmind

# DigiKey Product Information API (optional — product search just returns no results
# from DigiKey without these, nothing else breaks). Get free sandbox credentials in
# minutes, no company account needed: https://developer.digikey.com
# (My DigiKey account -> create an organization -> create an app -> Sandbox environment)
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# Mouser Search API (optional, same idea as DigiKey above — product search just returns
# no results from Mouser without it). Apply here: https://www.mouser.com/api-hub/
# (sign in -> Search API -> apply for access). Unlike DigiKey, Mouser reviews requests
# manually — expect 1-2 business days before your key actually works, not instant.
MOUSER_API_KEY=

# Adafruit's Products API is public — no key needed, and it's on by default. Uncomment to
# turn it off (e.g. to skip fetching/caching its ~8MB product feed).
# ADAFRUIT_CATALOG_ENABLED=false
